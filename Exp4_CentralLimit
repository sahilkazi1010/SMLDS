import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Step 1: Load Dataset
# Change the file path to the location of your dataset
data = pd.read_csv("/Salary_Data.csv")

print(data.head())

# Step 2: Generate Sample Means
# Replace "Salary" with the actual NUMERIC column name
# Change n=20 if the question specifies a different sample size
means = []

for i in range(1000):
    sample = data.sample(n=20)
    means.append(sample["Salary"].mean())

# Step 3: Plot Histogram of Sample Means
# Change the label to match the selected numeric column
plt.hist(means, bins=30, edgecolor="black")

plt.xlabel("Mean Salary")
plt.ylabel("Frequency")
plt.title("Central Limit Theorem")

plt.show()
