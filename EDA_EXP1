import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset (change filename as required)
df = pd.read_csv('dataset.csv')

# Display first 10 and last 10 records
print(df.head(10))
print(df.tail(10))

# Display descriptive statistics
print(df.describe())

# Calculate mean of all numeric columns
print("Mean:")
print(df.mean(numeric_only=True))

# Calculate mode of each column
print("Mode:")
print(df.mode().iloc[0])

# Calculate variance of all numeric columns
print("Variance:")
print(df.var(numeric_only=True))

# Calculate kurtosis of all numeric columns
print("Kurtosis:")
print(df.kurtosis(numeric_only=True))

# Display histograms of numeric columns
df.select_dtypes(include='number').hist(figsize=(12, 8))
plt.tight_layout()
plt.show()

# Display correlation matrix
corr_matrix = df.corr(numeric_only=True)
print("Correlation Matrix:")
print(corr_matrix)

# Scatter plot (replace with actual column names)
plt.scatter(df['column1'], df['column2'])
plt.xlabel('column1')
plt.ylabel('column2')
plt.title('Scatter Plot')
plt.show()

# Line plot (use suitable columns)
plt.plot(df['column1'], df['column2'])
plt.xlabel('column1')
plt.ylabel('column2')
plt.title('Line Plot')
plt.show()

# Box plot (replace with a numeric column)
sns.boxplot(x=df['column1'])
plt.title('Box Plot')
plt.show()

# Heatmap of correlation matrix
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm')
plt.title('Correlation Heatmap')
plt.show()
