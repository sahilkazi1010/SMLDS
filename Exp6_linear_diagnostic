import pandas as pd
import matplotlib.pyplot as plt
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

# Step 1: Load dataset (change file path as required)
data = pd.read_csv("/content/Salary_Data.csv")

print(data.head())
print("Columns:", data.columns.tolist())

# Step 2: Select columns and remove missing values
# Replace column1 with a NUMERIC input/independent variable
# Replace column2 with a NUMERIC target/dependent variable
data_clean = data[["column1", "column2"]].dropna()

X = data_clean[["column1"]]
y = data_clean["column2"]

# Step 3: Perform Linear Regression
# Add a constant/intercept to the input variable
X = sm.add_constant(X)
model = sm.OLS(y, X).fit()

print(model.summary())

# Step 4: Predict target values
pred = model.predict(X)

# Step 5: Plot Linear Regression
# X-axis uses the input column; Y-axis uses the target column
plt.scatter(data_clean["column1"], y)
plt.plot(data_clean["column1"], pred, color="red")
plt.xlabel("column1")
plt.ylabel("column2")
plt.title("Linear Regression")
plt.show()

# Step 6: Plot Residuals
# Residual = actual value - predicted value
residual = y - pred

plt.scatter(pred, residual)
plt.axhline(y=0, color="red")
plt.xlabel("Predicted Values")
plt.ylabel("Residuals")
plt.title("Residual Plot")
plt.show()

# Step 7: Calculate Variance Inflation Factor (VIF)
# VIF checks multicollinearity between input variables.
# With only one input variable, VIF is not very informative.
print("VIF:")

for i in range(1, X.shape[1]):
    print(variance_inflation_factor(X.values, i))

# Step 8: Calculate and plot Cook's Distance
# Cook's Distance identifies influential observations.
influence = model.get_influence()
cooks = influence.cooks_distance[0]

plt.stem(cooks)
plt.xlabel("Data Points")
plt.ylabel("Cook's Distance")
plt.title("Cook's Distance")
plt.show()
