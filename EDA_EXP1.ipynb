import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load dataset
df = pd.read_csv("/content/student_performance_analysis.csv")

# Display first and last records
print("First Five Records:")
print(df.head())

print("\nLast Five Records:")
print(df.tail())

# Descriptive statistics
print("\nDescriptive Statistics:")
print(df.describe())

# Mean
print("\nMean:")
print(df[['hours_studied', 'attendance_percent',
          'assignments_completed', 'test_score']].mean())

# Mode
print("\nMode:")
print(df[['hours_studied', 'attendance_percent',
          'assignments_completed', 'test_score']].mode().iloc[0])

# Variance
print("\nVariance:")
print(df[['hours_studied', 'attendance_percent',
          'assignments_completed', 'test_score']].var())

# Histograms
df[['hours_studied', 'attendance_percent',
    'assignments_completed', 'test_score']].hist(
    figsize=(10, 6), bins=10
)
plt.suptitle("Histogram of Features")
plt.tight_layout()
plt.show()

# Scatter plot
plt.scatter(df['hours_studied'], df['test_score'])
plt.xlabel("Hours Studied")
plt.ylabel("Test Score")
plt.title("Scatter Plot")
plt.show()

# Line plot
plt.plot(df['hours_studied'], df['test_score'], marker='o')
plt.xlabel("Hours Studied")
plt.ylabel("Test Score")
plt.title("Line Plot")
plt.show()

# Box plot
sns.boxplot(x=df['test_score'])
plt.title("Box Plot of Test Score")
plt.show()

# Correlation matrix
corr_matrix = df[
    ['hours_studied', 'attendance_percent',
     'assignments_completed', 'test_score']
].corr()

print("\nCorrelation Matrix:")
print(corr_matrix)

# Heatmap
sns.heatmap(corr_matrix, annot=True, cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()
